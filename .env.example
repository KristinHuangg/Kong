# Copy to .env before running the app:  cp .env.example .env
# These defaults match docker-compose.yml, so no edits are needed for local dev.

NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=service_catalog

# Logs every SQL statement TypeORM issues. Useful when verifying that the
# list query produces a single JOIN rather than an N+1.
DB_LOGGING=false
